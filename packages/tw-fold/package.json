{
  "name": "@grainshape/tw-fold",
  "type": "module",
  "version": "0.0.2",
  "description": "Tailwind-aware variant utility — @grainshape/fold pre-configured with tailwind-merge",
  "author": "John van Dijk",
  "license": "MIT",
  "keywords": [
    "cva",
    "class-variance",
    "tailwind",
    "tailwind-merge",
    "variants"
  ],
  "main": "dist/fold.js",
  "typings": "dist/fold.d.ts",
  "exports": {
    ".": {
      "import": "./dist/fold.js",
      "types": "./dist/fold.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prebuild": "pnpm run clean",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@grainshape/fold": "workspace:*",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}

{
  "name": "@grainshape/tw-fold",
  "type": "module",
  "version": "0.0.3",
  "description": "Tailwind-aware variant utility — @grainshape/fold pre-configured with tailwind-merge",
  "author": "John van Dijk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grainshape/fold.git",
    "directory": "packages/tw-fold"
  },
  "homepage": "https://github.com/grainshape/fold/tree/main/packages/tw-fold#readme",
  "bugs": "https://github.com/grainshape/fold/issues",
  "keywords": [
    "cva",
    "class-variance",
    "tailwind",
    "tailwind-merge",
    "variants"
  ],
  "main": "dist/fold.js",
  "typings": "dist/fold.d.ts",
  "exports": {
    ".": {
      "types": "./dist/fold.d.ts",
      "import": "./dist/fold.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prebuild": "pnpm run clean",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@grainshape/fold": "workspace:*",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}

{
  "name": "@grainshape/fold",
  "type": "module",
  "version": "0.1.0",
  "description": "Type-safe class-variant utility library",
  "author": "John van Dijk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grainshape/fold.git",
    "directory": "packages/fold"
  },
  "homepage": "https://github.com/grainshape/fold/tree/main/packages/fold#readme",
  "bugs": "https://github.com/grainshape/fold/issues",
  "keywords": [
    "cva",
    "class-variance",
    "tailwind",
    "variants",
    "clsx"
  ],
  "main": "dist/fold.js",
  "typings": "dist/fold.d.ts",
  "exports": {
    ".": {
      "types": "./dist/fold.d.ts",
      "import": "./dist/fold.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "prebuild": "pnpm run clean",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
